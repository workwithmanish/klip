[Desktop Entry]
Version=1.0
Type=Application
Name=Klip
GenericName=Screenshot Tool
Comment=Capture and annotate your screen
Exec=klip --background
Icon=/usr/share/klip/assets/klip.png
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;capture;annotation;
StartupNotify=false
Actions=Capture;OCR;Settings;

[Desktop Action Capture]
Name=Capture area
Exec=klip --capture

[Desktop Action Settings]
Name=Klip settings
Exec=klip --settings

[Desktop Action OCR]
Name=Capture text (OCR)
Exec=klip --ocr
